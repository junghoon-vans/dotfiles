      "anthropic",
      "google",
      "github-copilot",
      "vercel",
      "zai-coding-plan",
      "kimi-for-coding",
      "moonshotai",
      "moonshotai-cn",
      "firmware",
      "ollama-cloud",
      "aihubmix",
      "venice"
    ],
    "model_fallback": true,
    "runtime_fallback": {
      "enabled": true,
      "retry_on_errors": [
        402,
        429,
        500,
        502,
        503,
        504
      ],
      "max_fallback_attempts": 5,
      "cooldown_seconds": 30,
      "timeout_seconds": 30,
      "notify_on_fallback": true,
      "restore_primary_after_cooldown": false
    },
    "browser_automation_engine": {
      "provider": "playwright"
    },
    "skills": {
      "enable": [
        "git-master",
        "playwright",
        "review-work",
        "ai-slop-remover",
        "frontend-ui-ux"
      ]
    },
    "notification": {
      "force_enable": true
    },
