{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "oh-my-openagent@latest"
  ],
  "provider": {
    "omniroute": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OmniRoute",
      "options": {
        "baseURL": "http://localhost:20128/v1",
        "apiKey": "{env:OMNIROUTE_API_KEY}"
      },
      "models": {
        "auto/best-coding": {
          "name": "Auto: Best Coding"
        },
        "auto/best-reasoning": {
          "name": "Auto: Best Reasoning"
        },
        "auto/best-fast": {
          "name": "Auto: Best Fast"
        },
        "auto/best-free": {
          "name": "Auto: Best Free"
        },
        "auto/coding": {
          "name": "Auto: Coding"
        },
        "auto/fast": {
          "name": "Auto: Fast"
        },
        "auto/cheap": {
          "name": "Auto: Cheap"
        },
        "auto/offline": {
          "name": "Auto: Offline"
        },
        "auto/smart": {
          "name": "Auto: Smart"
        },
        "opencode-go/deepseek-v4-flash": {
          "name": "OpenCode Go: DeepSeek V4 Flash"
        },
        "gemini/gemini-3-flash-preview": {
          "name": "Gemini: Gemini 3 Flash Preview"
        },
        "kiro/claude-sonnet-4.5": {
          "name": "Kiro: Claude Sonnet 4.5"
        }
      }
    }
  },
  "mcp": {
    "atlassian": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp/authv2",
      "enabled": true
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "gnomcp": {
      "type": "local",
      "command": [
        "/bin/bash",
        "-lc",
        "exec \"$HOME/.local/bin/gnomcp\""
      ],
      "enabled": true
    },
    "firecrawl": {
      "type": "local",
      "command": [
        "/bin/zsh",
        "-lc",
        "source \"$HOME/.zshrc.local\" 2>/dev/null || true; exec npx -y firecrawl-mcp"
      ],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "environment": {
        "PLAYWRIGHT_MCP_EXECUTABLE_PATH": "/Applications/Aside.app/Contents/MacOS/Aside"
      },
      "enabled": true
    },
    "aside": {
      "type": "local",
      "command": [
        "aside",
        "mcp"
      ],
      "enabled": true
    },
    "omniroute": {
      "type": "local",
      "command": [
        "omniroute",
        "--mcp"
      ],
      "enabled": true
    }
  },
  "lsp": {
    "bash": {
      "command": [
        "bash-language-server",
        "start"
      ],
      "extensions": [
        ".sh",
        ".bash",
        ".zsh",
        ".ksh"
      ]
    },
    "biome": {
      "command": [
        "biome",
        "lsp-proxy",
        "--stdio"
      ],
      "extensions": [
        ".json",
        ".jsonc"
      ]
    },
    "gopls": {
      "command": [
        "/bin/bash",
        "-lc",
        "exec mise exec go@1.25 -- gopls"
      ],
      "extensions": [
        ".go"
      ]
    },
    "marksman": {
      "command": [
        "marksman",
        "server"
      ],
      "extensions": [
        ".md"
      ]
    },
    "gnopls": {
      "command": [
        "/bin/bash",
        "-lc",
        "exec mise exec go@1.25 -- gnopls -mode=stdio"
      ],
      "extensions": [
        ".gno"
      ]
    },
    "jdtls": {
      "command": [
        "/bin/bash",
        "-lc",
        "project_hash=$(printf \"%s\" \"$PWD\" | shasum | cut -d\" \" -f1); mkdir -p \"$HOME/Library/Caches/jdtls/workspaces\"; exec mise exec java@temurin-21 -- jdtls -data \"$HOME/Library/Caches/jdtls/workspaces/$project_hash\""
      ],
      "extensions": [
        ".java"
      ]
    },
    "kotlin-ls": {
      "command": [
        "/bin/bash",
        "-lc",
        "exec mise exec java@temurin-21 kotlin@latest -- kotlin-language-server"
      ],
      "extensions": [
        ".kt",
        ".kts"
      ]
    },
    "pyright": {
      "command": [
        "/bin/bash",
        "-lc",
        "exec mise exec python@3.13 -- pyright-langserver --stdio"
      ],
      "extensions": [
        ".py"
      ]
    },
    "rust": {
      "command": [
        "/bin/bash",
        "-lc",
        "exec mise exec rust@latest -- \"$(brew --prefix rust-analyzer)/bin/rust-analyzer\""
      ],
      "extensions": [
        ".rs"
      ]
    },
    "terraform": {
      "command": [
        "terraform-ls",
        "serve"
      ],
      "extensions": [
        ".tf",
        ".tfvars"
      ]
    },
    "typescript-language-server": {
      "command": [
        "/bin/bash",
        "-lc",
        "PATH=\"$(mise exec bun@latest -- bun pm bin -g):$PATH\" exec mise exec node@24 bun@latest -- typescript-language-server --stdio"
      ],
      "extensions": [
        ".ts",
        ".tsx",
        ".js",
        ".jsx"
      ]
    },
    "xml": {
      "command": [
        "/bin/bash",
        "-lc",
        "exec mise exec java@temurin-21 -- java ${LEMMINX_JAVA_OPTS:-} -jar \"$HOME/.local/share/lemminx/lemminx.jar\""
      ],
      "extensions": [
        ".xml",
        ".xsd",
        ".xsl",
        ".xslt",
        ".svg"
      ]
    },
    "yaml-ls": {
      "command": [
        "yaml-language-server",
        "--stdio"
      ],
      "extensions": [
        ".yaml",
        ".yml"
      ]
    }
  }
}
